# Copy to .env for your OWN isolated environment. Never commit the filled file.
# This template is not a runnable production configuration.

# 1. Model provider: required when Settings is loaded. Choose ONE supported provider.
LLM_PROVIDER=openai
LLM_MODEL=replace-with-your-model-id
OPENAI_BASE_URL=http://127.0.0.1:65433/v1
OPENAI_API_KEY=placeholder-not-a-secret
# Alternative providers, only if selected as LLM_PROVIDER:
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional OpenAI-compatible fallback; each enabled slot needs URL + model + key.
LLM_FALLBACK_1_BASE_URL=
LLM_FALLBACK_1_MODEL=
LLM_FALLBACK_1_API_KEY=
LLM_FALLBACK_2_BASE_URL=
LLM_FALLBACK_2_MODEL=
LLM_FALLBACK_2_API_KEY=
LLM_PRIMARY_MAX_ATTEMPTS=2
LLM_PRIMARY_TIMEOUT_SECONDS=12
LLM_FALLBACK_TIMEOUT_SECONDS=45

# 2. PostgreSQL: replace both URLs with the SAME isolated database.
# These examples intentionally point to a nonstandard port and cannot start a service.
DATABASE_URL=postgresql+asyncpg://release_example:invalid@127.0.0.1:65432/release_example
DATABASE_URL_SYNC=postgresql://release_example:invalid@127.0.0.1:65432/release_example

# 3. Telegram: empty / false until an operator has reviewed the real target.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_LIVE_START_PREFLIGHT_ACK=false
TELEGRAM_ALLOWED_INGRESS_IDS=
REMINDER_ALLOWED_TELEGRAM_IDS=
DAILY_RUNDOWN_ALLOWED_TELEGRAM_IDS=

# 4. Optional Google Calendar MCP: third-party local Server, one bound account.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CREDENTIALS_FILE=
GOOGLE_CALENDAR_OWNER_TELEGRAM_ID=
# Optional separate Gmail OAuth grant: read only, one bound account.
GMAIL_ENABLED=false
GMAIL_CREDENTIALS_FILE=
GMAIL_TOKEN_FILE=
GMAIL_OWNER_TELEGRAM_ID=

# 5. Optional Web workbench. Requires built web/dist, trusted HTTPS origin,
# non-default SECRET_KEY, and an operator-bound login / Mini App setup.
WEB_ENABLED=false
WEB_PUBLIC_ORIGIN=
WEB_SESSION_HOURS=24
APP_ENV=development
SECRET_KEY=change_me_in_production

# 6. Proactive notifications: keep disabled for a fresh public copy.
DEFAULT_TIMEZONE=Asia/Shanghai
SCHEDULER_ENABLED=false
DAILY_RUNDOWN_ENABLED=false
DAILY_BRIEF_HOUR=8
SHUTDOWN_DRAIN_SECONDS=30
MESSAGING_TERMINAL_RETENTION_DAYS=30

# 7. Optional web search and current memory mode.
TAVILY_API_KEY=
MEMORY_ENABLED=true
MEMORY_MODE=transcript_lexical
MEMORY_CONTEXT_TOKEN_BUDGET=8192
