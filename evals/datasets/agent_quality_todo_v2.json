    {"id":"todo-holdout-create","split":"holdout","initial_todos":[],"turns":["请加一个待办，名称是“{title}”。"],"expected_status":"pending","required_tools":["create_todo"]},
    {"id":"todo-holdout-missing","split":"holdout","initial_todos":[],"turns":["我已经做完“{title}”，帮我更新一下状态。"],"expected_status":null,"required_tools":[],"require_owned_unchanged":true}
  ]
