  "cases": [
    {"id":"todo-create","split":"dev","initial_todos":[],"turns":["创建任务：{title}"],"expected_status":"pending","required_tools":["create_todo"]},
    {"id":"todo-create-read","split":"dev","initial_todos":[],"turns":["创建任务：{title}","列出我的任务。"],"expected_status":"pending","required_tools":["create_todo","list_todos"],"reply_must_include_title":true},
    {"id":"todo-create-complete","split":"dev","initial_todos":[],"turns":["创建任务：{title}","把“{title}”标记完成。"],"expected_status":"done","required_tools":["create_todo","update_todo"]},
    {"id":"todo-pronoun-complete","split":"dev","initial_todos":[],"turns":["创建任务：{title}","把刚才创建的那项任务标记完成。"],"expected_status":"done","required_tools":["create_todo","update_todo"]},
    {"id":"todo-missing-target","split":"dev","initial_todos":[],"turns":["把“{title}”标记完成。"],"expected_status":null,"required_tools":[],"require_owned_unchanged":true},
